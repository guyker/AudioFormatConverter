{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Check Build Environment",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (!(Test-Path -Path 'C:/ProgramData/mingw64/mingw64/bin/g++.exe')) { Write-Error 'MinGW GCC is not installed or not in expected location' }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "showReuseMessage": true
            }
        },
        {
            "label": "Download FFmpeg",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-NoProfile",
                "-Command",
                "if (!(Test-Path -Path 'C:\\dev\\POC-DEV\\AudioFormatConverter\\external\\ffmpeg')) { Invoke-WebRequest -Uri 'https://github.com/BtbN/FFmpeg-Builds/releases/latest/download/ffmpeg-master-latest-win64-gpl-shared.zip' -OutFile \"$env:TEMP\\ffmpeg.zip\"; Expand-Archive -Path \"$env:TEMP\\ffmpeg.zip\" -DestinationPath 'C:\\dev\\POC-DEV\\AudioFormatConverter\\external\\ffmpeg' -Force; Remove-Item \"$env:TEMP\\ffmpeg.zip\" } else { Write-Host 'FFmpeg already exists, skipping download' }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "showReuseMessage": true
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Remove-Item -Recurse -Force '${workspaceFolder}/../external/obj' -ErrorAction SilentlyContinue; Remove-Item -Force '${workspaceFolder}/../RunMe_FLAC_Convert.exe' -ErrorAction SilentlyContinue"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "showReuseMessage": true
            }
        },
        {
            "label": "Pre-Build: Ensure obj folder exists",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (!(Test-Path -Path '${workspaceFolder}/../external/obj')) { New-Item -ItemType Directory -Path '${workspaceFolder}/../external/obj' }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "never"
            }
        },
        {
            "label": "Build Debug",
            "dependsOn": ["Pre-Build: Ensure obj folder exists"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the project in Debug configuration",
            "type": "shell",
            "command": "C:/ProgramData/mingw64/mingw64/bin/g++.exe",
            "args": [
                "-DDEBUG",
                "-DUNICODE",
                "-D_UNICODE",
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-Iinclude",
                "-I.",
                "-I${workspaceFolder}/../external/spdlog/include",
                "-I${workspaceFolder}/../external/sqlite-amalgamation",
                "-I${workspaceFolder}/../external/ffmpeg/ffmpeg-master-latest-win64-gpl-shared/include",
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "-L${workspaceFolder}/../external/ffmpeg/ffmpeg-master-latest-win64-gpl-shared/lib",
                "${workspaceFolder}/../external/obj/sqlite3.o",
                "-lavformat",
                "-lavcodec",
                "-lavutil",
                "-lswresample",
                "-lswscale",
                "-lavfilter",
                "-lwinmm",
                "-lbcrypt",
                "-lz",
                "-lm",
                "-lpsapi",
                "-lole32",
                "-loleaut32",
                "-luuid",
                "-lstdc++fs",
                "-lshell32",
                "-o",
                "${workspaceFolder}/../RunMe_FLAC_Convert_Debug.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
"problemMatcher": {
    "owner": "cpp",
    "fileLocation": ["relative", "${workspaceFolder}"],
    "pattern": {
        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "severity": 4,
        "message": 5
    }
},            "presentation": {
                "reveal": "always",
                "showReuseMessage": true
            }
        },
        {
            "label": "Build Release",
            "dependsOn": ["Pre-Build: Ensure obj folder exists"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Builds the project in Release configuration",
            "type": "shell",
            "command": "C:/ProgramData/mingw64/mingw64/bin/g++.exe",
            "args": [
                "-DNDEBUG",
                "-DUNICODE",
                "-D_UNICODE",
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-Iinclude",
                "-I.",
                "-I${workspaceFolder}/../external/spdlog/include",
                "-I${workspaceFolder}/../external/sqlite-amalgamation",
                "-I${workspaceFolder}/../external/ffmpeg/ffmpeg-master-latest-win64-gpl-shared/include",
                "-O3",
                "${workspaceFolder}/src/*.cpp",
                "-L${workspaceFolder}/../external/ffmpeg/ffmpeg-master-latest-win64-gpl-shared/lib",
                "${workspaceFolder}/../external/obj/sqlite3.o",
                "-lavformat",
                "-lavcodec",
                "-lavutil",
                "-lswresample",
                "-lswscale",
                "-lavfilter",
                "-lwinmm",
                "-lbcrypt",
                "-lz",
                "-lm",
                "-lpsapi",
                "-lole32",
                "-loleaut32",
                "-luuid",
                "-lstdc++fs",
                "-lshell32",
                "-o",
                "${workspaceFolder}/../RunMe_FLAC_Convert_Release.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
"problemMatcher": {
    "owner": "cpp",
    "fileLocation": ["relative", "${workspaceFolder}"],
    "pattern": {
        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "severity": 4,
        "message": 5
    }
},            "presentation": {
                "reveal": "always",
                "showReuseMessage": true
            }
        }
    ]
}