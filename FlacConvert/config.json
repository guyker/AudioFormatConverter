      "mediaName": "flac"
    },
    {
      "isActive": false,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\mp3",
      "mediaName": "mp3"
    },
    {
      "isActive": false,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\flac_tracks2",
      "mediaName": "flac_tracks2"
    }
  ],
  "LogLevel": 1,
  "UseAsyncFFmpegCalls": true,
  "UseFFmpegLibraryAPI": true,
  "ExtraAudioQualityMetrics": false,
