{
  "Version": "1.0.0",
  "OutDirectory": "\\\\?\\R:\\tmp\\24",
  "DatabaseFileName": "all_albums.db",
  "FLACSettings": {
    "ffmpeg_exe_name": "ffmpeg",
    "ffmpeg_convert_24bit_flac": "-map 0:a:0 -af aresample=osf=s16:osr=44100:dither_method=triangular -c:a flac -y -v warning -stats",
    "ffmpeg_get_metadata_tags": "-v quiet -print_format json -show_format -show_streams -show_chapters"
  },
  "MediaDirectoryList": [
    {
      "isActive": true,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\flac",
      "mediaName": "flac"
    },
    {
      "isActive": false,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\mp3",
      "mediaName": "mp3"
    },
    {
      "isActive": false,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\flac_tracks2",
      "mediaName": "flac_tracks2"
    }
  ],
  // Original FLAC metadata archives are used by conversion runs only (menu 1/6 and CLI convert).
  "MetadataSidecars": {
    // "binary" writes .flac-metadata.
    // "json" writes .flac-metadata.json (readable metadata plus the exact archive as Base64).
    "Format": "binary",
    // "disabled" never writes a sidecar; "optional" writes by default; "required" always writes one.
    // For optional, the menu prompts and CLI --no-metadata-sidecar turns it off; required rejects that flag.
    // Without a sidecar, conversion fails rather than lose metadata the output format cannot represent.
    // These defaults disable sidecars for both target formats.
    "ConvertToFlac": "disabled",
    "ConvertToMp3": "disabled"
  },
  "LogLevel": 1,
  "UseAsyncFFmpegCalls": true,
  "MetadataScanMaxThreads": 0,
  "UseFFmpegLibraryAPI": true,
  "ExtraAudioQualityMetrics": false,
  "MinMatchingTracksForDuplicate": 1,
  "SizeMatchPercentageThreshold": 3,
  "RecursionDirectorySearchDepth": 10,
  "AlbumsSplitThreshold": 2000
}