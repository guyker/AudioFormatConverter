{
  "Version": "1.0.0",
  "OutDirectory": "\\\\?\\R:\\tmp\\24",
  "DatabaseFileName": "all_albums.db",
  "FLACSettings": {
    "ffmpeg_exe_name": "ffmpeg",
    "ffmpeg_convert_24bit_flac": "-map 0:a:0 -af aresample=osf=s16:osr=44100:dither_method=triangular -c:a flac -y -v warning -stats",
    "ffmpeg_get_metadata_tags": "-v quiet -print_format json -show_format -show_streams -show_chapters"
  },
  "MediaDirectoryList": [
    {
      "isActive": true,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\flac",
      "mediaName": "flac"
    },
    {
      "isActive": false,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\mp3",
      "mediaName": "mp3"
    },
    {
      "isActive": false,
      "mediaPath": "\\\\?\\R:\\tmp\\24\\flac_tracks2",
      "mediaName": "flac_tracks2"
    }
  ],
  // MetadataSidecars applies to conversion runs only (menu 1/6 and CLI convert).
  // Scan metadata archives are controlled independently by ScanFlacMetadataArchives below.
  "MetadataSidecars": {
    // "binary" writes .flac-metadata.
    // "json" writes .flac-metadata.json (readable metadata plus the exact archive as Base64).
    "Format": "binary",
    // "disabled" never writes a sidecar; "optional" writes by default; "required" always writes one.
    // For optional, the menu prompts and CLI --no-metadata-sidecar turns it off; required rejects that flag.
    // Without a sidecar, conversion fails rather than lose metadata the output format cannot represent.
    // These defaults disable sidecars for both target formats.
    "ConvertToFlac": "disabled",
    "ConvertToMp3": "disabled"
  },
  "LogLevel": 1,
  "UseAsyncMetadataReads": true,
  "Incremental": true,
  // Option 2/scan: export byte-exact native FLAC metadata archives separately from catalog JSON.
  // The menu asks per run; scan --archive-flac-metadata/--no-archive-flac-metadata override this value.
  "ScanFlacMetadataArchives": false,
  // Default scan depth; CLI scan --tier overrides this for one run.
  // catalog reads tags/properties; integrity fully decodes; analysis adds signal measurements.
  "ScanTier": "catalog",
  "MetadataScanMaxThreads": 0,
  // Independent cap for full decodes; 0 uses min(4, hardware threads / 2).
  "DecodeWorkers": 0,
  // Catalog extensions; FLAC and MP3 have partial native inventory, other formats use TagLib properties.
  // Additional supported extensions: .m4a, .mp4, .ogg, .oga, .opus, .wv, .ape, .wav, .aif, .aiff.
  "CatalogExtensions": [".flac", ".mp3"],
  "ExtraAudioQualityMetrics": false,
  "MinMatchingTracksForDuplicate": 1,
  // Duplicate track durations match within max(DuplicateDurationToleranceSeconds,
  // SizeMatchPercentageThreshold % of the longer track).
  "SizeMatchPercentageThreshold": 1,
  "DuplicateDurationToleranceSeconds": 2,
  // Opt-in duplicate matching: similar names (same artists), ignoring edition text, partial track lists.
  "DuplicateFuzzyNames": false,
  "DuplicateStripEditionText": false,
  "DuplicatePartialMatches": false,
  "DuplicatePartialMinCoverage": 80,
  "RecursionDirectorySearchDepth": 10,
  "AlbumsSplitThreshold": 2000
}